# Copy to .env and fill in. Never commit .env.

# --- Drone ---
# Must equal UAVs.UavCode in UAV-PMS (e.g. UAV-HCM-01). Used in the topic drone/{DRONE_ID}/telemetry.
DRONE_ID=UAV-HCM-01

# --- MAVLink source (Mission Planner) ---
# Mission Planner: Ctrl+F -> "MAVLink" (mirror) -> UDP Outbound to 127.0.0.1:14550, then use udpin below.
# Other options: tcp:127.0.0.1:5762 (SITL), COM3 / /dev/ttyUSB0 with MAVLINK_BAUD.
MAVLINK_CONNECTION=udpin:0.0.0.0:14550
MAVLINK_BAUD=57600
# 0 = lock onto the first autopilot heartbeat; set a number to accept only that system id.
MAVLINK_TARGET_SYSTEM=0
# Ask the autopilot for data streams (ignored by some links, e.g. a read-only mirror).
MAVLINK_REQUEST_STREAMS=true
MAVLINK_STREAM_RATE_HZ=4

# --- MQTT (EMQX Cloud) ---
MQTT_HOST=fff1a88e.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=true
# Optional CA file (EMQX Serverless: emqxsl-ca.crt). Empty = system/certifi CA bundle.
MQTT_CA_CERT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
MQTT_QOS=1
MQTT_KEEPALIVE_S=30
# Messages kept while the broker is unreachable (150 x 2 s = 5 minutes). Oldest are dropped first.
MQTT_MAX_QUEUED=150

# --- Publishing ---
PUBLISH_INTERVAL_S=2
# A message group older than this is published as null instead of a stale value.
STALE_AFTER_S=5
# No autopilot heartbeat for this long = link lost (nothing is published).
HEARTBEAT_TIMEOUT_S=5
# Minimum GPS fix for lat/lon (2 = 2D, 3 = 3D). Below it lat/lon are null.
MIN_GPS_FIX=3
LOG_LEVEL=INFO
