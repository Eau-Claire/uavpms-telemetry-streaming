# Copy to phone_gateway/.env. Never commit .env.
# MQTT_* are also read from the repo's ../.env (same names as the MAVLink publisher), so they need not be repeated.

# Topic is drone/{PHONE_DEVICE_ID}/telemetry. To show the phone as a drone in UAV-PMS, use that drone's UavCode.
PHONE_DEVICE_ID=PHONE-001
# Required, >= 16 chars. The tunnel URL is public: without the token nobody can send or watch. Generate: openssl rand -hex 16
PHONE_ACCESS_TOKEN=
# Keep 127.0.0.1: only the tunnel reaches the gateway.
PHONE_HTTP_HOST=127.0.0.1
PHONE_HTTP_PORT=3000
# Fixes with a larger error radius (m) are published as "no fix" (lat/lon null).
PHONE_MAX_ACCURACY_M=50
# Default: phone_gateway/data
PHONE_HISTORY_DIR=

PUBLISH_INTERVAL_S=2
STALE_AFTER_S=5

# MQTT is on when MQTT_HOST is set here or in ../.env (the MAVLink publisher's file). PHONE_MQTT=off turns it off.
PHONE_MQTT=on
# Only needed if ../.env has no MQTT settings. Uncomment and fill in:
#MQTT_HOST=
#MQTT_PORT=8883
#MQTT_TLS=true
#MQTT_CA_CERT=
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_QOS=1
#MQTT_MAX_QUEUED=150
